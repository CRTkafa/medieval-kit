    "viewer:build": "vite build --config vite.viewer.config.ts && bun scripts/build-artifact.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.9.2",
    "vibe3d": "^0.0.1",
    "vite": "^7.1.5"
  }
}
