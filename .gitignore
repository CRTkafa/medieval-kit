node_modules/

# Build output. `my-registry/dist/registry.json` is produced by the build
# script; it is not committed, and `bun run registry:build` rebuilds it.
dist/
dist-viewer/

# Output of `bun run render` and `bun run export:glb`. Both are regenerated
# from source, and keeping them here would mean rewriting several megabytes
# of binaries on every change.
renders/
glb/

# The flythrough's PNG sequence and the video cut from it. 720 frames of 1080p
# is about two gigabytes, and both come back from one command.
frames/
*.mp4

*.log
*.tgz
*.tsbuildinfo
.DS_Store

# Agent and tool state
.omc/
.claude/settings.local.json

# models.lock.json is INTENTIONALLY tracked: it records which version the
# installed source came from, and `vibe3d diff` uses it to find local edits.
scripts/probe.ts
scripts/zdiag.ts

# Reference images. They belong to the (private) studio repo, not to the
# registry that consumers clone.
references/

# Cloudflare's "import a repository" flow offers to write one of these, and it
# describes a WORKER serving static assets rather than a Pages project. The
# site is deployed as Pages, so a config for the other path does not belong in
# the tree — and it is not inert if it gets there: the build log reports
# "Checking for configuration in a Wrangler configuration file", so a stray one
# would change how the project is treated.
wrangler.toml
wrangler.json
wrangler.jsonc

# The critic writes one verdict per model here. Regenerated, and the working
# copies of the two images it compares live under it.
critiques/
