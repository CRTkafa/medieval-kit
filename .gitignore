node_modules/

# Build output. `my-registry/dist/registry.json` is produced by the build
# script; it is not committed, and `bun run registry:build` rebuilds it.
dist/
dist-viewer/

# Output of `bun run render` and `bun run export:glb`. Both are regenerated
# from source, and keeping them here would mean rewriting several megabytes
# of binaries on every change.
renders/
glb/

*.log
*.tgz
*.tsbuildinfo
.DS_Store

# Agent and tool state
.omc/
.claude/settings.local.json

# models.lock.json is INTENTIONALLY tracked: it records which version the
# installed source came from, and `vibe3d diff` uses it to find local edits.
scripts/probe.ts
scripts/zdiag.ts

# Reference images. They belong to the (private) studio repo, not to the
# registry that consumers clone.
references/
